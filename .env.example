# ══════════════════════════════════════════════
#  Falantir Frontend — Environment Template
# ══════════════════════════════════════════════
# Copy this file to `.env` (or `.env.local`) and fill in real values.
#
# All VITE_* variables are baked into the client bundle at build time,
# so they are PUBLIC. Do NOT store secrets here.

# ─── Backend REST API ─────────────────────────
# Local dev    : http://localhost:8000/api
# Staging      : https://staging.falantir.app/api
# Production   : https://api.falantir.app/api
VITE_API_URL=http://localhost:8000/api

# ─── Backend WebSocket (Socket.IO) ────────────
# Same host as the API, but WITHOUT the /api path suffix.
# Local dev    : http://localhost:8000
# Production   : https://api.falantir.app
VITE_SOCKET_URL=http://localhost:8000

# ─── App metadata (optional) ──────────────────
VITE_APP_NAME=Falantir
VITE_APP_VERSION=2.1.0
